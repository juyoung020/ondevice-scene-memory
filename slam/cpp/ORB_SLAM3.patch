+// 지금 지도가 다른 지도에 재위치되면(같은 변환 두 번) 작은 지도를 큰 지도 좌표로 옮겨 하나로 합침.
+// 빈틈 뒤 새 지도가 생겨도 예전 지도를 다시 보는 순간 한 지도로 이어짐.
+void Tracking::TryGraft()
+{
+    if(mpAtlas->CountMaps() < 2 || mCurrentFrame.mnId < mnGraftTry + 3) return;
+    // 지도 잠금을 잡은 채라 전체 최적화 잠금은 보지 않음(그 스레드가 거꾸로 잡음), 합칠 때(DoPendingGraft) 확인
+    mnGraftTry = mCurrentFrame.mnId;
+    Map* pCur = mpAtlas->GetCurrentMap();
+    const Sophus::SE3f Tcw_cur = mCurrentFrame.GetPose();
+    const Frame saved(mCurrentFrame);
+    const unsigned int savedReloc = mnLastRelocFrameId;
+    vector<Map*> vpMaps = mpAtlas->GetAllMaps();
+    sort(vpMaps.begin(), vpMaps.end(), [](Map* a, Map* b){ return a->KeyFramesInMap() > b->KeyFramesInMap(); });
+    for(Map* pM : vpMaps)
+    {
+        if(pM == pCur || pM->IsBad() || pM->KeyFramesInMap() == 0) continue;
+        const bool ok = Relocalization(pM);
+        const Sophus::SE3f Tcw_m = mCurrentFrame.GetPose();
+        mCurrentFrame = Frame(saved);
+        mnLastRelocFrameId = savedReloc;
+        if(!ok) continue;
+        // S: pM 좌표 <- 지금 지도 좌표
+        const Sophus::SE3f S = Tcw_m.inverse() * Tcw_cur;
+        if(mpGraftMap != pM || mCurrentFrame.mnId > mnGraftFrame + 30)
+        {
+            mpGraftMap = pM; mGraftS = S; mnGraftFrame = mCurrentFrame.mnId;
+            return;
+        }
+        const Sophus::SE3f D = mGraftS.inverse() * S;
+        const float dt = D.translation().norm();
+        const float da = D.so3().log().norm() * 180.f / M_PI;
+        mGraftS = S; mnGraftFrame = mCurrentFrame.mnId;
+        if(dt > 0.10f || da > 2.0f) return;
+        cout << "GRAFT map " << pCur->GetId() << " (" << pCur->KeyFramesInMap() << " kf) <-> map " << pM->GetId()
+             << " (" << pM->KeyFramesInMap() << " kf) dt=" << dt << " da=" << da << endl;
+        // 지도 잠금을 잡은 채라 다음 장면 시작(잠그기 전)에 합침
+        // 늘 지금 지도를 옮김(다른 스레드가 쥔 키프레임 · 지도는 지금 지도 쪽만 바뀜)
+        mpPendFrom = pCur; mpPendInto = pM; mPendS = S; mbPendMoveCam = true;
+        mpGraftMap = nullptr;
+        return;
+    }
+}
+
+// 두 지도 모두 세계 z 가 중력 위라 옮겨 붙이는 변환은 z 축 방위 + 이동만 남김
+static Sophus::SE3f YawOnly(const Sophus::SE3f &S)
+{
+    const Eigen::Matrix3f R = S.rotationMatrix();
+    const float yaw = atan2(R(1, 0), R(0, 0));
+    return Sophus::SE3f(Eigen::AngleAxisf(yaw, Eigen::Vector3f::UnitZ()).toRotationMatrix(), S.translation());
+}
+
+void Tracking::DoPendingGraft()
+{
+    if(!mpPendFrom) return;
+    Map* pFrom = mpPendFrom; Map* pInto = mpPendInto; mpPendFrom = mpPendInto = nullptr;
+    if(pFrom->IsBad() || pInto->IsBad()) return;
+    // 루프 · 합치기 · 전체 최적화 중이면 다음 장면에 다시
+    std::unique_lock<std::mutex> busy(mpLoopClosing->mMutexBusy, std::try_to_lock);
+    if(!busy.owns_lock() || mpLoopClosing->isRunningGBA()) { mpPendFrom = pFrom; mpPendInto = pInto; return; }
+    const bool moveCam = pFrom == mpAtlas->GetCurrentMap();
+    mPendS = YawOnly(mPendS);
+    GraftMap(pFrom, pInto, mPendS);
+    if(moveCam)
+    {
+        mLastFrame.SetPose(mLastFrame.GetPose() * mPendS.inverse());
+        mpAtlas->ChangeMap(pInto);
+    }
+}
+
+void Tracking::GraftMap(Map* pFrom, Map* pInto, const Sophus::SE3f &S0)
+{
+    const Sophus::SE3f S = YawOnly(S0);
+    while(mpLocalMapper->KeyframesInQueue() > 0 && !mpLocalMapper->isFinished()) usleep(1000);
+    mpLocalMapper->RequestStop();
+    while(!mpLocalMapper->isStopped() && !mpLocalMapper->isFinished()) usleep(1000);
+    {
+        unique_lock<mutex> l1(pFrom->mMutexMapUpdate);
+        unique_lock<mutex> l2(pInto->mMutexMapUpdate);
+        const Sophus::SE3f Sinv = S.inverse();
+        vector<KeyFrame*> vpFrom = pFrom->GetAllKeyFrames();
+        set<KeyFrame*> sFrom(vpFrom.begin(), vpFrom.end());
+        KeyFrame* pOrigin = nullptr;
+        for(KeyFrame* pKF : vpFrom)
+        {
+            if(!pKF) continue;
+            if(!pKF->isBad() && (!pOrigin || pKF->mnId < pOrigin->mnId)) pOrigin = pKF;
+            pKF->SetPose(pKF->GetPose() * Sinv);
+            pKF->UpdateMap(pInto);
+            pInto->AddKeyFrame(pKF);
+            pFrom->EraseKeyFrame(pKF);
+        }
+        for(MapPoint* pMP : pFrom->GetAllMapPoints())
+        {
+            if(!pMP) continue;
+            pMP->SetWorldPos(S * pMP->GetWorldPos());
+            pMP->SetNormalVector(S.so3() * pMP->GetNormal());
+            pMP->UpdateMap(pInto);
+            pInto->AddMapPoint(pMP);
+            pFrom->EraseMapPoint(pMP);
+        }
+        // 옮긴 지도의 뿌리를 합친 지도의 가장 가까운 키프레임에 매달아 나무 하나로
+        if(pOrigin && !pOrigin->GetParent())
+        {
+            KeyFrame* pBest = nullptr; float best = 1e9;
+            const Eigen::Vector3f c = pOrigin->GetCameraCenter();
+            for(KeyFrame* pKF : pInto->GetAllKeyFrames())
+            {
+                if(!pKF || pKF->isBad() || sFrom.count(pKF)) continue;
+                const float d = (pKF->GetCameraCenter() - c).norm();
+                if(d < best) { best = d; pBest = pKF; }
+            }
+            if(pBest) pOrigin->ChangeParent(pBest);
+        }
+        mpAtlas->SetMapBad(pFrom);
+        pInto->IncreaseChangeIndex();
+        pInto->InformNewBigChange();
+    }
+    mpAtlas->RemoveBadMaps();
+    mpLocalMapper->Release();
+}
+
