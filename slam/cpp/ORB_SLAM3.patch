+void Tracking::WaitMappingIdle()
+{
+    for(int i = 0; i < 4000; i++)
+    {
+        if(mpLocalMapper->isStopped() || mpLocalMapper->isFinished()) return;
+        if(mpLocalMapper->KeyframesInQueue() == 0 && mpLocalMapper->AcceptKeyFrames()) return;
+        usleep(500);
+    }
+}
