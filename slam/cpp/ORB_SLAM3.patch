+namespace ORB_SLAM3
+{
+bool Tracking::RequestGraft(unsigned long from_id, unsigned long into_id, const Sophus::SE3f &S)
+{
+    Map *pFrom = nullptr, *pInto = nullptr;
+    for(Map* m : mpAtlas->GetAllMaps())
+    {
+        if(m->GetId() == from_id) pFrom = m;
+        if(m->GetId() == into_id) pInto = m;
+    }
+    if(!pFrom || !pInto || pFrom == pInto || mpPendFrom) return false;
+    cout << "GRAFT(ext) map " << from_id << " (" << pFrom->KeyFramesInMap() << " kf) -> map " << into_id << " (" << pInto->KeyFramesInMap() << " kf)" << endl;
+    mPendS = S; mbPendMoveCam = true; mpPendInto = pInto; mpPendFrom = pFrom;
+    return true;
+}
